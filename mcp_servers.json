{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MCP Servers Configuration for Antigravity Agent - Research Paper AI Edition",
  "servers": [
    {
      "name": "context7",
      "description": "Code intelligence for imports, file reviews, and code suggestions",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@context7/mcp-server"],
      "enabled": true,
      "env": {},
      "priority": "high",
      "use_cases": ["code_review", "import_suggestions", "file_analysis"]
    },
    {
      "name": "memory",
      "description": "Graph memory for persistent research context and paper references",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "env": {},
      "priority": "high",
      "use_cases": ["research_context", "paper_references", "analysis_history"]
    },
    {
      "name": "filesystem",
      "description": "Access to local filesystem for research papers and code",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true,
      "env": {},
      "priority": "high",
      "use_cases": ["paper_storage", "code_access", "artifact_management"]
    },
    {
      "name": "github",
      "description": "GitHub API for code repository analysis and cross-referencing",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "priority": "high",
      "use_cases": ["repo_analysis", "code_mining", "issue_tracking"]
    },
    {
      "name": "postgres",
      "description": "PostgreSQL for research data storage and analysis",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "enabled": false,
      "env": {
        "POSTGRES_CONNECTION_STRING": "${DATABASE_URL}"
      },
      "priority": "low",
      "use_cases": ["data_storage", "analysis_results", "citation_database"]
    },
    {
      "name": "brave-search",
      "description": "Academic paper search and research literature discovery",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": true,
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "priority": "high",
      "use_cases": ["paper_search", "literature_review", "research_discovery"]
    },
    {
      "name": "puppeteer",
      "description": "Web scraping for research papers (ArXiv, Google Scholar, etc.)",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true,
      "env": {},
      "priority": "medium",
      "use_cases": ["paper_scraping", "citation_extraction", "metadata_collection"]
    },
    {
      "name": "slack",
      "description": "Slack workspace integration",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "enabled": false,
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    {
      "name": "custom-http",
      "description": "Example HTTP/Streamable HTTP server",
      "transport": "http",
      "url": "http://localhost:8000/mcp",
      "enabled": false,
      "env": {}
    }
  ]
}
