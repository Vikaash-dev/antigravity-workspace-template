# Antigravity Workspace Configuration - Research Paper AI Edition
# Copy this file to .env and configure your API keys

# ============================================================
# AI Model Configuration
# ============================================================

# Google Gemini API Key (Primary LLM)
# Get your key at: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=AIzaSyBwwM0EXAMPLEKEY1234567890
# GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional: OpenAI API Key for alternative LLM
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Model Configuration
# MODEL_NAME=gemini-2.5-flash

# ============================================================
# MCP Server Configuration (Using Unified Antigravity API)
# ============================================================

# All MCPs now use the ANTIGRAVITY_API_KEY above
# No need for separate API keys!

# Enable MCP (Model Context Protocol) integration
MCP_ENABLED=true

# Agent behavior settings
AGENT_NAME=ResearchAssistant
MAX_ITERATIONS=10
TEMPERATURE=0.7

# GitHub Token - For repository analysis (still needed for GitHub API)
# Generate at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_github_token_here

# PostgreSQL Database (Optional - for storing research data)
# DATABASE_URL=postgresql://user:password@localhost:5432/research_db

# Slack Integration (Optional - for team collaboration)
# SLACK_BOT_TOKEN=xoxb-your-slack-token
# SLACK_TEAM_ID=T1234567890

# ============================================================
# Agent Configuration
# ============================================================

# Enable MCP (Model Context Protocol) integration
MCP_ENABLED=true

# Agent behavior settings
# AGENT_NAME=ResearchAssistant
# MAX_ITERATIONS=10
# TEMPERATURE=0.7

# ============================================================
# Sandbox Configuration (Code Execution)
# ============================================================
# These settings control how code execution is sandboxed.

# Sandbox type to use for code execution.
# Supported values may include: "local", "docker", "e2b"
# SANDBOX_TYPE=local

# Maximum time (in seconds) each sandboxed execution is allowed to run.
# SANDBOX_TIMEOUT_SEC=30

# Maximum amount of output (in kilobytes) captured from sandboxed runs.
# SANDBOX_MAX_OUTPUT_KB=64

# Docker-based sandbox settings (used when SANDBOX_TYPE=docker)

# Docker image to use for sandboxed executions.
# DOCKER_IMAGE=antigravity-sandbox:latest

# Whether the Docker sandbox is allowed network access ("true" or "false").
# DOCKER_NETWORK_ENABLED=false

# CPU limit for the Docker container (e.g., "0.5" for half a CPU).
# DOCKER_CPU_LIMIT=1.0

# Memory limit for the Docker container (e.g., "512m", "1g").
# DOCKER_MEMORY_LIMIT=512m
