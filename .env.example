# Antigravity Workspace - Autonomous Research AI with Unified API & ACP

# 🌐 UNIFIED ANTIGRAVITY API (ONE KEY FOR ALL!)
ANTIGRAVITY_API_KEY=your_antigravity_unified_key_here

# Fallback keys (if not using unified API)
# GOOGLE_API_KEY=your_gemini_key
# CLAUDE_API_KEY=your_claude_key  

# 🤖 Agent Context Protocol (ACP)
ACP_ENABLED=true
AUTONOMOUS_MODE=true
MAX_CONCURRENT_AGENTS=5
DEEP_RESEARCH_MODE=true

# 🧠 AI Configuration
DEFAULT_MODEL_TIER=balanced
TEMPERATURE=0.7
MCP_ENABLED=true

# ⚡ Parallel Execution
MAX_PARALLEL_TASKS=6
AUTO_IMPORT_MCP_TASKS=true

# 🔬 Research Features
AUTO_LITERATURE_REVIEW=true
AUTO_CROSS_ANALYSIS=true
AUTO_CODE_GENERATION=true
AUTO_PAPER_WRITING=true
LITERATURE_REVIEW_PAPER_COUNT=30

# 💾 Performance
ENABLE_CACHING=true
CACHE_DURATION_HOURS=24

# 📊 Monitoring
ENABLE_USAGE_TRACKING=true
ENABLE_COST_MONITORING=true
LOG_LEVEL=INFO

# Optional: GitHub token for repo analysis
# GITHUB_TOKEN=ghp_your_token
